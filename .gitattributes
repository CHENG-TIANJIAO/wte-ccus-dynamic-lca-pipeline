# The reference result files are compared byte for byte against a fresh run, so no
# end-of-line normalisation may be applied to them on checkout. The csv module writes
# CRLF on every platform (RFC 4180), which is what these files contain.
*.csv -text
*.json -text
*.xlsx binary
*.xlsb binary

# MANIFEST_SHA256.txt gives the digest of every file as it is stored here, so no file may
# change on checkout: the source and documentation keep their line endings (LF) as well.
*.py -text
*.md -text
*.txt -text
*.cff -text
*.log -text
.gitignore -text
.gitattributes -text
LICENSE -text
